# Copy this file to .env for local Unity Editor, desktop, or WebGL telemetry.
# Never commit the populated .env file.

# Informational: the Unity telemetry client currently uses this Loki username.
LOKI_USER=beetrap

# Replace with the Loki password supplied for local development.
LOKI_PASSWORD=replace_with_loki_password

# Required only for Level 8 poster generation. This key stays in the local
# launcher process and is never copied into the Unity WebGL files.
OPENAI_API_KEY=replace_with_openai_api_key
